# Django / Render Web Service
SECRET_KEY=change-me
DEBUG=True
OCR_ENABLED=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local SQLite. Set this in Render from the Render PostgreSQL
# internal connection string when the Web Service and PostgreSQL are in the
# same Render workspace and region.
DATABASE_URL=

# React / Vercel origins that are allowed to call the Django API.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cross-site cookies are required when Vercel and Render are on different
# domains in production.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# PaddleOCR downloads its public Japanese OCR model on first use. BOS is an
# alternative model source when Hugging Face is unavailable from the host.
PADDLE_PDX_MODEL_SOURCE=BOS
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_OCR_VERSION=PP-OCRv3
PADDLE_ENABLE_MKLDNN=False

# Production only. Both the Render Web Service and Background Worker must use
# the same value. Keep this secret out of GitHub.
CLOUDINARY_URL=
